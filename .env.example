# Salin ke .env lalu isi. Jangan pernah commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
JWT_SECRET=

# Satu versi model yang dikunci, jangan alias "latest".
LLM_MODEL=
# live | scripted  (scripted = tanpa internet, respons diberi penanda mode skrip)
LLM_MODE=live
LLM_TIMEOUT_SECONDS=6

# Asal frontend yang diizinkan, dipisah koma.
ALLOWED_ORIGINS=http://localhost:5173
