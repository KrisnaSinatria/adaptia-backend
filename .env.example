# Salin ke .env lalu isi. Jangan pernah commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
# Acak dan panjang, misalnya: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Satu versi model yang dikunci. gpt-oss-20b mendukung JSON schema strict di Groq dan cepat.
LLM_MODEL=openai/gpt-oss-20b
# Model analis bukti. Kuota token Groq dihitung per model, jadi model terpisah membagi beban;
# 120b juga lebih jarang memberi "terpenuhi" palsu. Kosong = sama dengan LLM_MODEL.
LLM_ANALYST_MODEL=openai/gpt-oss-120b
# Hanya untuk model penalaran (gpt-oss): low | medium | high. Kosongkan untuk model non-penalaran.
LLM_REASONING_EFFORT=low
# live | scripted  (scripted = tanpa internet; respons diberi penanda "mode": "scripted")
LLM_MODE=live
LLM_TIMEOUT_SECONDS=6

# Asal frontend yang diizinkan, dipisah koma. Bukan "*".
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
